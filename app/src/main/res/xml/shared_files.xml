<?xml version="1.0" encoding="utf-8"?>
<!-- The photos Django used in answers and the event log can be shared with other apps. -->
<paths>
    <files-path name="assistant" path="assistant/photos/" />
    <cache-path name="log" path="log/" />
    <!-- A picture sent from the glasses as an MMS, read by the phone's MMS service. -->
    <cache-path name="mms" path="mms/" />
    <!-- A photo a VDK app took while the camera was live. -->
    <cache-path name="kit" path="kit/" />
</paths>
