<?xml version="1.0" encoding="utf-8"?>
<!-- The mark unlit, as the system splash shows it: the app takes it from here and lights it (stage/MarkIntro.kt). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group android:scaleX="0.234375" android:scaleY="0.234375"
        android:translateX="24" android:translateY="24">
        <path
            android:fillColor="#1D1D1F"
            android:fillType="evenOdd"
            android:pathData="@string/django_mark_path" />
    </group>
</vector>
