<?xml version="1.0" encoding="utf-8"?>
<!-- Fit the 256-unit mark into the middle 60 dp of the 108 dp adaptive grid. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group android:scaleX="0.234375" android:scaleY="0.234375"
        android:translateX="24" android:translateY="24">
        <path android:fillType="evenOdd" android:pathData="@string/django_mark_path">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="128"
                    android:startY="46"
                    android:endX="128"
                    android:endY="210"
                    android:startColor="#FFFFFF"
                    android:endColor="#FFD2A1" />
            </aapt:attr>
        </path>
    </group>
</vector>
